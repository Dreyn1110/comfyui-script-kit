{
  "1": {
    "class_type": "LoadImage",
    "_meta": { "title": "载入待改图（DSH 注入源图）" },
    "inputs": { "image": "{{image}}" }
  },
  "2": {
    "class_type": "FluxKontextImageScale",
    "_meta": { "title": "缩放到模型支持的分辨率" },
    "inputs": { "image": ["1", 0] }
  },
  "3": {
    "class_type": "CLIPLoaderGGUF",
    "_meta": { "title": "Qwen2.5-VL 文本编码器（GGUF 量化）" },
    "inputs": {
      "clip_name": "Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf",
      "type": "qwen_image"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": { "title": "Qwen-Image VAE" },
    "inputs": { "vae_name": "qwen_image_vae.safetensors" }
  },
  "5": {
    "class_type": "UnetLoaderGGUF",
    "_meta": { "title": "Qwen-Image-Edit-2511 (GGUF 量化，无 Lightning)" },
    "inputs": { "unet_name": "qwen-image-edit-2511-Q3_K_S.gguf" }
  },
  "6": {
    "class_type": "ModelSamplingAuraFlow",
    "_meta": { "title": "采样偏移 shift=3.1（官方值）" },
    "inputs": { "model": ["5", 0], "shift": 3.1 }
  },
  "7": {
    "class_type": "CFGNorm",
    "_meta": { "title": "CFGNorm（true CFG 4.0 前置）" },
    "inputs": { "model": ["6", 0], "strength": 1.0 }
  },
  "8": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "正向提示词（DSH 注入）" },
    "inputs": {
      "clip": ["3", 0],
      "prompt": "{{prompt}}",
      "vae": ["4", 0],
      "image1": ["2", 0]
    }
  },
  "9": {
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": { "title": "负向提示词" },
    "inputs": {
      "clip": ["3", 0],
      "prompt": "",
      "vae": ["4", 0],
      "image1": ["2", 0]
    }
  },
  "10": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "参考方法 index_timestep_zero（正）" },
    "inputs": {
      "conditioning": ["8", 0],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "11": {
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": { "title": "参考方法 index_timestep_zero（负）" },
    "inputs": {
      "conditioning": ["9", 0],
      "reference_latents_method": "index_timestep_zero"
    }
  },
  "12": {
    "class_type": "VAEEncode",
    "_meta": { "title": "源图编码为 latent" },
    "inputs": { "pixels": ["2", 0], "vae": ["4", 0] }
  },
  "13": {
    "class_type": "KSampler",
    "_meta": { "title": "采样（官方 40 步 / CFG 4.0）" },
    "inputs": {
      "model": ["7", 0],
      "seed": "{{seed}}",
      "steps": 40,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["10", 0],
      "negative": ["11", 0],
      "latent_image": ["12", 0],
      "denoise": 1.0
    }
  },
  "14": {
    "class_type": "VAEDecode",
    "_meta": { "title": "解码" },
    "inputs": { "samples": ["13", 0], "vae": ["4", 0] }
  },
  "15": {
    "class_type": "SaveImage",
    "_meta": { "title": "保存结果" },
    "inputs": { "images": ["14", 0], "filename_prefix": "QwenEdit2511Q" }
  }
}
